# Market data (Binance public REST — no key required for klines/ticker/depth)
BINANCE_BASE_URL=https://api.binance.com

# Watchlist for the single supported market (crypto spot via Binance)
WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,AVAXUSDT
SCAN_INTERVAL=1h

# Quality filter / ranking thresholds (0-100 score)
SCORE_WATCH_MIN=70
SCORE_HIGH_QUALITY_MIN=80
SCORE_EXCEPTIONAL_MIN=90
NOTIFY_MIN_SCORE=80

# Costs applied to every backtest and paper trade — never zero unless you
# deliberately want to test a cost-free (unrealistic) scenario.
FEE_BPS=10
SLIPPAGE_BPS=5

# Optional: news catalyst provider. Leave unset and the system will report
# catalyst score as 0/10 with an explicit "no data" reason rather than ever
# assuming positive news.
CRYPTOPANIC_API_KEY=

# Optional: outbound webhook (Slack/Discord-compatible "text" payload) for
# HIGH_QUALITY/EXCEPTIONAL signal notifications. Leave unset to only log to
# console.
NOTIFY_WEBHOOK_URL=

# Telegram — the primary "KÖP NU" / "SÄLJ NU" delivery channel.
# Setup (~2 min): message @BotFather on Telegram, send /newbot, follow the
# prompts to get a bot token. Then message your new bot anything (so it's
# allowed to message you back), and open
# https://api.telegram.org/bot<token>/getUpdates in a browser to find your
# numeric chat_id in the response. Leave both unset to skip Telegram
# delivery (still logs to console / sends to NOTIFY_WEBHOOK_URL if set).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Background scheduler — off by default. When enabled, the app scans for
# new entries every SCAN_LOOP_MINUTES and checks open positions for an
# exit every MONITOR_LOOP_MINUTES, without you needing to click anything.
ENABLE_SCHEDULER=false
SCAN_LOOP_MINUTES=30
MONITOR_LOOP_MINUTES=5
# Finer candle granularity used only to monitor OPEN positions for a
# stop/target hit — independent of each strategy's own entry timeframe.
MONITOR_KLINE_INTERVAL=5m

# Optional "quiet hours" gate on ENTRY ("köp nu") notifications only — an
# open position's exit ("sälj nu") always alerts regardless of the hour.
# Off by default (crypto trades 24/7, so nothing is gated unless you ask).
TRADING_HOURS_ENABLED=false
TRADING_HOURS_START=09:00
TRADING_HOURS_END=22:00
TRADING_HOURS_TIMEZONE=Europe/Stockholm
TRADING_DAYS=mon,tue,wed,thu,fri,sat,sun

DB_PATH=tradingbot.db
