# NOTE: everything below except FEE_BPS/SLIPPAGE_BPS and NOTIFY_WEBHOOK_URL
# can ALSO be changed live from the dashboard's Settings tab, without
# editing this file or restarting — that DB-backed override takes
# priority over whatever is set here. Use this file for the initial
# setup / secrets provisioning; use Settings for day-to-day tuning.

# Market data: Yahoo Finance via `yfinance` — no API key needed, the only
# zero-cost option covering thousands of US tickers. See
# app/data/stock_client.py for why, and the upgrade path if that changes.

# Starting watchlist — ~50 liquid, historically volatile US growth/momentum
# names spanning several sectors (semis/AI, EV, biotech, fintech,
# crypto-adjacent, cybersecurity, space). This is a starting point to edit
# (in Settings or here), not a "best picks" endorsement. With no paid data
# budget this scans a watchlist, not the whole market — see README.
WATCHLIST=NVDA,TSLA,AMD,PLTR,SMCI,MSTR,COIN,SOFI,RBLX,DKNG,CVNA,UPST,AFRM,HOOD,RIVN,MARA,RIOT,IONQ,ARM,CRWD,NET,SNOW,SHOP,ROKU,MU,MRVL,ON,MRNA,NVAX,CRSP,NTLA,NIO,LI,XPEV,ENPH,PLUG,FSLR,SQ,OKTA,RKLB,CHWY,ETSY,W,CLSK,HUT,AI,SOUN,BBAI,BEAM,EDIT
# Daily bars — this is a swing/position-trade caller (weeks-to-months
# horizon hunting large moves), not an intraday scalper.
SCAN_INTERVAL=1d

# Quality filter / ranking thresholds (0-100 score)
SCORE_WATCH_MIN=70
SCORE_HIGH_QUALITY_MIN=80
SCORE_EXCEPTIONAL_MIN=90
NOTIFY_MIN_SCORE=80

# Costs applied to every backtest and paper trade — never zero unless you
# deliberately want to test a cost-free (unrealistic) scenario. Defaults
# assume a typical US retail commission-free broker (spread + slippage
# only) — raise FEE_BPS if yours charges per-trade commission.
FEE_BPS=5
SLIPPAGE_BPS=5

# No stock news/catalyst provider is wired up yet — see
# app/data/news_client.py for the scoring logic and where a real source
# (e.g. Finnhub's free-tier company-news endpoint) would plug in.
# Catalyst honestly scores 0/10 with a stated reason until then.

# Optional: outbound webhook (Slack/Discord-compatible "text" payload) for
# HIGH_QUALITY/EXCEPTIONAL signal notifications. Leave unset to only log to
# console.
NOTIFY_WEBHOOK_URL=

# Telegram — the primary "KÖP NU" / "SÄLJ NU" delivery channel.
# Setup (~2 min): message @BotFather on Telegram, send /newbot, follow the
# prompts to get a bot token. Then message your new bot anything (so it's
# allowed to message you back), and open
# https://api.telegram.org/bot<token>/getUpdates in a browser to find your
# numeric chat_id in the response. Leave both unset to skip Telegram
# delivery (still logs to console / sends to NOTIFY_WEBHOOK_URL if set).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Background scheduler — off by default. When enabled, the app scans for
# new entries every SCAN_LOOP_MINUTES and checks open positions for an
# exit every MONITOR_LOOP_MINUTES. A daily bar doesn't change until the
# next trading day closes, so hourly is already more than often enough —
# this mainly exists to catch you up promptly after each day's close.
ENABLE_SCHEDULER=false
SCAN_LOOP_MINUTES=60
MONITOR_LOOP_MINUTES=60
# Candle granularity used to monitor OPEN positions for a stop/target hit.
# Same as the entry timeframe by default — intraday precision doesn't add
# much for a multi-week swing position.
MONITOR_KLINE_INTERVAL=1d

# Optional "quiet hours" gate on ENTRY ("köp nu") notifications only — an
# open position's exit ("sälj nu") always alerts regardless of the hour.
# Off by default.
TRADING_HOURS_ENABLED=false
TRADING_HOURS_START=09:00
TRADING_HOURS_END=22:00
TRADING_HOURS_TIMEZONE=Europe/Stockholm
TRADING_DAYS=mon,tue,wed,thu,fri,sat,sun

DB_PATH=tradingbot.db
